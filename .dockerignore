# Build context of the api image (docker-compose.yml: `build: .`).
# The image copies only requirements.txt and backend/; everything else is kept
# out of the context, and secrets never enter it.

.git
.github

# Secrets: every .env file except the example
.env
.env.*
**/.env
**/.env.*
!.env.example

# Virtualenvs
.venv
**/.venv
venv
**/venv
env

# The frontend has its own image and build context (./frontend)
frontend
**/node_modules

# Eval reports (git-ignored, regenerated by python -m evals.run)
backend/evals/reports

# Caches and build output
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.cache
**/.coverage
**/htmlcov
