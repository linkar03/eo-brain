# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# --- Orchestrator agent (Gemini) ------------------------------------------
# Without a key the chat endpoint answers "AI agent is not configured" and the
# rest of the app (map, manual analyses) still works.
GEMINI_API_KEY=

# Model ids. Empty = defaults in backend/eo_brain/agent/providers/gemini.py.
# GEMINI_FALLBACK_MODELS is a comma-separated chain tried in order on errors.
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# --- Data agent (read-only text-to-SQL over the "agent" views) -------------
# Password of the least-privilege role agent_reader. Used by the db init script
# (only on a fresh volume) and by the api service to build AGENT_DATABASE_URL.
AGENT_DB_PASSWORD=change-me

# Outside docker compose, point the api at the role directly. Unset = the
# query_database tool reports "not configured".
# AGENT_DATABASE_URL=postgresql://agent_reader:change-me@localhost:5433/eo_brain

# --- Tests -------------------------------------------------------------------
# Superuser URL to a PostGIS maintenance database. Enables the tests marked
# "db" and the SQL eval suite; they create and drop their own scratch database,
# but the role agent_reader is cluster-wide: it is created if missing and its
# password is reset to a random value. Use a throwaway PostGIS server only.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
